{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://vpauzmjmyzumodntpbdg.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "jurismind-mcp",
      "version": "0.1.0",
      "title": "JurisMind"
    },
    "tools": [
      {
        "name": "list_cases",
        "title": "Listar casos",
        "description": "Lista casos do usuário com paginação, ordenação e filtros (status, tipo, jurisdição/tribunal, busca textual, intervalo de datas de criação). Retorna também 'total' e 'nextOffset' para paginação consistente.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "active",
                "archived",
                "closed",
                "all"
              ]
            },
            "case_type": {
              "description": "Filtra por tipo de caso.",
              "type": "string"
            },
            "jurisdiction": {
              "description": "Filtra por jurisdição/tribunal (ex.: 'STF', 'TJSP'). Substring, case-insensitive.",
              "type": "string"
            },
            "search": {
              "description": "Busca textual em título, cliente ou número CNJ.",
              "type": "string"
            },
            "created_from": {
              "description": "Data ISO inicial (created_at >=).",
              "type": "string"
            },
            "created_to": {
              "description": "Data ISO final (created_at <).",
              "type": "string"
            },
            "sort_by": {
              "description": "Padrão: created_at.",
              "type": "string",
              "enum": [
                "created_at",
                "updated_at",
                "title",
                "client_name",
                "status"
              ]
            },
            "sort_dir": {
              "description": "Padrão: desc.",
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            },
            "limit": {
              "description": "Padrão 25.",
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "offset": {
              "description": "Padrão 0.",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_case",
        "title": "Detalhes do caso",
        "description": "Retorna todos os campos de um caso do JurisMind pelo id (partes envolvidas, descrição, número CNJ, jurisdição, honorários e prazos periciais).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "case_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "UUID do caso."
            }
          },
          "required": [
            "case_id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_documents",
        "title": "Listar documentos",
        "description": "Lista documentos do usuário com paginação, ordenação e filtros (caso, status de indexação, tipo de arquivo, busca por nome, período). O 'case_id' é opcional — sem ele lista todos os documentos do usuário. Retorna 'total' e 'nextOffset'.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "case_id": {
              "description": "Filtra por caso.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "processing_status": {
              "description": "Filtra por status de indexação.",
              "type": "string",
              "enum": [
                "pending",
                "processing",
                "ready",
                "error",
                "all"
              ]
            },
            "file_type": {
              "description": "Filtra por MIME/tipo (substring, case-insensitive).",
              "type": "string"
            },
            "search": {
              "description": "Busca em filename.",
              "type": "string"
            },
            "created_from": {
              "description": "created_at >= (ISO).",
              "type": "string"
            },
            "created_to": {
              "description": "created_at < (ISO).",
              "type": "string"
            },
            "sort_by": {
              "description": "Padrão: created_at.",
              "type": "string",
              "enum": [
                "created_at",
                "updated_at",
                "filename",
                "file_size",
                "processing_status"
              ]
            },
            "sort_dir": {
              "description": "Padrão: desc.",
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            },
            "limit": {
              "description": "Padrão 50.",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "search_documents",
        "title": "Buscar nos documentos (RAG)",
        "description": "Faz busca semântica + textual (RAG híbrido) nos documentos do usuário no JurisMind. Retorna trechos relevantes com o id do documento e do caso. Pode ser escopado a um caso específico.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 2,
              "maxLength": 500,
              "description": "Pergunta ou termo a buscar."
            },
            "case_id": {
              "description": "Se informado, restringe a busca a esse caso.",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "limit": {
              "description": "Máx. de trechos (padrão 8).",
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_tasks",
        "title": "Listar tarefas",
        "description": "Lista tarefas do usuário com paginação, ordenação e filtros (caso, status, prioridade, intervalo de due_date, busca textual). Retorna 'total' e 'nextOffset'.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "case_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "in_progress",
                "blocked",
                "done",
                "all"
              ]
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "urgent",
                "all"
              ]
            },
            "due_from": {
              "description": "due_date >= (ISO).",
              "type": "string"
            },
            "due_to": {
              "description": "due_date < (ISO).",
              "type": "string"
            },
            "overdue": {
              "description": "Se true, retorna apenas tarefas vencidas não concluídas.",
              "type": "boolean"
            },
            "search": {
              "description": "Busca em título/descrição.",
              "type": "string"
            },
            "sort_by": {
              "description": "Padrão: created_at.",
              "type": "string",
              "enum": [
                "created_at",
                "updated_at",
                "due_date",
                "priority",
                "status",
                "title"
              ]
            },
            "sort_dir": {
              "description": "Padrão: desc.",
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "create_task",
        "title": "Criar tarefa",
        "description": "Cria uma nova tarefa para o usuário autenticado no JurisMind, opcionalmente vinculada a um caso.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "Título da tarefa."
            },
            "description": {
              "description": "Descrição opcional.",
              "type": "string",
              "maxLength": 4000
            },
            "case_id": {
              "description": "UUID do caso vinculado (opcional).",
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "urgent"
              ]
            },
            "due_date": {
              "description": "Data ISO (YYYY-MM-DD) do prazo.",
              "type": "string"
            }
          },
          "required": [
            "title"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "search_jurisprudence",
        "title": "Buscar jurisprudência",
        "description": "Pesquisa decisões judiciais em tribunais brasileiros (STF, STJ, TST, TSE, TJs). Retorna URL, tribunal, data e trechos relevantes. Requer capacidade 'cases' do usuário autenticado.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": true
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "minLength": 3,
              "maxLength": 500,
              "description": "Termos de busca (ex: 'dano moral extravio bagagem STJ')."
            },
            "courts": {
              "description": "Restringe a tribunais específicos. Vazio = todos os suportados.",
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "STF",
                  "STJ",
                  "TST",
                  "TSE",
                  "TJSP",
                  "TJRJ",
                  "TJMG",
                  "TJRS",
                  "TJPR",
                  "TJDFT"
                ]
              }
            },
            "limit": {
              "description": "Máx. de resultados (padrão 8).",
              "type": "integer",
              "minimum": 1,
              "maximum": 15
            }
          },
          "required": [
            "query"
          ]
        },
        "outputSchema": null
      }
    ]
  }
